# 服务器生产配置说明（部署目录：/opt/superbox，compose.yaml 与 .env 同目录）。
# 部署时 GitHub Actions 自动创建或更新镜像地址；COS 密钥需手动填写到同目录的 .env。
# 如需固定版本或回滚，可把下面的地址改为某个 commit SHA 的镜像（需已由工作流推送过）。
SUPERBOX_IMAGE=ghcr.io/glassous/superbox-backend:latest

# Tencent Cloud COS Configuration
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=superbox-1350226447
COS_REGION=ap-tokyo
COS_CUSTOM_DOMAIN=superboxfiles.fiacloud.top
